PORT=8001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1

# Auth
REFRESH_JWT_SECRET="my_custom_secret"
REFRESH_JWT_EXPIRES_IN=604800
JWT_SECRET="my_super_secret_goes_here"
JWT_EXPIRES_IN=3600

# Google OAuth 2.0
GOOGLE_CLIENT_ID="myGoogleId"
GOOGLE_CLIENT_SECRET="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Key123"
GOOGLE_CALLBACK_URL="http://localhost:8001/api/v1/auth/google/callback"

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_CALLBACK_URL=""

FRONTEND_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
POSTGRES_DB=nestjs_template
POSTGRES_USER=nestjs_app
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgresql://nestjs_app:change-me@localhost:5432/nestjs_template"

# --- Redis -------------------------------------------------------------------
REDIS_URL="redis://:change-me@localhost:6379/0"
REDIS_PASSWORD=change-me

# --- AWS S3 / MinIO ----------------------------------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=nestjs-template-dev
AWS_S3_ENDPOINT_URL="http://192.168.100.44:9000"
AWS_S3_REGION_NAME=us-east-1

# --- Email (SMTP) ------------------------------------------------------------
EMAIL_HOST="smtp.sendgrid.net"
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=alerts@example.com

# --- Sentry ------------------------------------------------------------------
SENTRY_DSN=test
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- MFA ---------------------------------------------------------------------
OTP_TOTP_ISSUER=NestJSTemplate
TP_TOTP_ISSUER=NestJSTemplate
